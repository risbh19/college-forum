# Next.js only: Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate independent random values of at least 32 characters.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Identity key: back up and never change after accounts exist.
ANON_PEPPER=

# Next.js only: shared Upstash rate limits (required outside the explicit local demo).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Both services: a separate shared signing key, never a NEXT_PUBLIC_ variable.
BACKEND_SHARED_SECRET=
BACKEND_URL=http://127.0.0.1:8000
# FastAPI: production enforces PostgreSQL TLS; development uses your explicit URL.
APP_ENV=development
# FastAPI only: comma-separated 32-character HMAC account IDs. Empty disables admin access.
ADMIN_ANON_IDS=
# Dedicated production admin credentials (optional, disabled until fully configured).
# Both services: synthetic operator ID from the offline generator; never reuse a student ID.
ADMIN_LOGIN_ACCOUNT_ID=
# Next.js only: enable explicitly, using HTTPS web/backend origins in production.
ADMIN_LOGIN_ENABLED=0
# Next.js only: random non-identifying version; rotate to revoke admin password sessions.
ADMIN_LOGIN_VERSION=
# FastAPI only: chosen operator username and scrypt hash, never a plaintext password.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD_HASH=
COLLEGE_FORUM_LOCAL=0
# FastAPI runtime: PostgreSQL/Supabase pooled connection.
DATABASE_URL=
# Alembic only: direct/session PostgreSQL connection for schema changes.
DIRECT_URL=
