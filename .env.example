# Next.js only: Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate independent random values of at least 32 characters.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Identity key: back up and never change after accounts exist.
ANON_PEPPER=
# College policy is fixed in lib/access-policy.ts; this value cannot broaden access.
ALLOWED_EMAIL_DOMAIN=rkgit.edu.in

# Both services: a separate shared signing key, never a NEXT_PUBLIC_ variable.
BACKEND_SHARED_SECRET=
BACKEND_URL=http://127.0.0.1:8000
# FastAPI: production enforces PostgreSQL TLS; development uses your explicit URL.
APP_ENV=development
COLLEGE_FORUM_LOCAL=0
# FastAPI runtime: PostgreSQL/Supabase pooled connection.
DATABASE_URL=
# Alembic only: direct/session PostgreSQL connection for schema changes.
DIRECT_URL=
