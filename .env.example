# Google OAuth web client ID.
GOOGLE_CLIENT_ID=
# Google OAuth web client secret.
GOOGLE_CLIENT_SECRET=
# Encrypts and signs the session JWT; generate with openssl rand -base64 32.
NEXTAUTH_SECRET=
# http://localhost:3000 locally.
NEXTAUTH_URL=
# openssl rand -hex 32, min 32 chars, never change after launch.
ANON_PEPPER=
# Optional, e.g. college.edu.
ALLOWED_EMAIL_DOMAIN=
# Supabase pooled connection, ends with ?pgbouncer=true.
DATABASE_URL=
# Supabase direct or session-pooler connection, used by prisma db push.
DIRECT_URL=
