# Set privately in Render. Never give Google/session/pepper secrets to FastAPI.
APP_ENV=production
COLLEGE_FORUM_LOCAL=0
BACKEND_URL=https://YOUR-BACKEND.onrender.com
BACKEND_SHARED_SECRET=
# Supabase pooled runtime URL, with URL-encoded password.
DATABASE_URL=
# Direct or session-pooler URL for Alembic. Do not use transaction pooling here.
DIRECT_URL=
# Render sets PORT automatically. Do not set it to the frontend's port.
